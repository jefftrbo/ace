<?xml version="1.0" encoding="UTF-8"?>
<!--
  HL7GoldenRecordFlow.msgflow
  ===========================
  IBM ACE v11 message flow — HL7 v2.5 ADT^A01 to Golden Record Candidate

  Flow:  HTTPInput -> Compute (HL7ToGoldenRecord) -> HTTPReply
  Port:  7800, path /hl7/golden-record

  nodeInternalName values verified from IntegrationAPI.jar HTTPInputNode.class:
    ComIbmWSInput   - HTTP input listener  (NODE_TYPE_NAME)
    ComIbmCompute   - ESQL Compute node
    ComIbmWSReply   - HTTP reply node
-->
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xmlns:broker="http://www.ibm.com/broker/2004/09/msgflow">

  <eClassifiers xsi:type="broker:MsgFlow"
      name="HL7GoldenRecordFlow">

    <composition xsi:type="broker:MsgFlowComposition">

      <nodes xmi:id="HTTPInput_1"
          nodeInternalName="ComIbmWSInput"
          id="HTTPInput_1"
          label="HL7 Admit (ADT^A01)"
          urlSpecifier="/hl7/golden-record"
          parseMethod="BLOB">
        <connections xmi:id="Conn_1"
            id="Conn_1"
            sourceNode="HTTPInput_1"
            sourceTerminalName="OutTerminal.out"
            targetNode="Compute_1"
            targetTerminalName="InTerminal.in"/>
      </nodes>

      <nodes xmi:id="Compute_1"
          nodeInternalName="ComIbmCompute"
          id="Compute_1"
          label="HL7 to Golden Record"
          computeExpression="esql://HL7ToGoldenRecord#HL7ToGoldenRecord.Main">
        <connections xmi:id="Conn_2"
            id="Conn_2"
            sourceNode="Compute_1"
            sourceTerminalName="OutTerminal.out"
            targetNode="HTTPReply_1"
            targetTerminalName="InTerminal.in"/>
      </nodes>

      <nodes xmi:id="HTTPReply_1"
          nodeInternalName="ComIbmWSReply"
          id="HTTPReply_1"
          label="HTTP Reply"/>

    </composition>

  </eClassifiers>

</ecore:EPackage>
